{
  "name": "minuteflow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @minuteflow/web dev",
    "build": "pnpm --filter @minuteflow/web build",
    "start": "pnpm --filter @minuteflow/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @minuteflow/db generate",
    "db:migrate": "pnpm --filter @minuteflow/db migrate"
  }
}
