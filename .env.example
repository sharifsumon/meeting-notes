# Copy to .env (local dev) or put in /root/meeting-notes.env on the server.
# Never commit real values.

# Public URL of the app (no trailing slash)
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 32 random bytes, base64. Encrypts OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=postgres://meetingnotes:password@127.0.0.1:5432/meetingnotes
REDIS_URL=redis://:password@127.0.0.1:6379

STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/meetingnotes/recordings
